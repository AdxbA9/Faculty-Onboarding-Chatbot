# Copy this file to ".env" and fill in your own Groq API key.
# Get a free key at: https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here

# Groq model. The code default (llama-3.3-70b-versatile) stopped being
# available to the project's account on 2026-11-01 (HTTP 404); the model
# verified since then is the one below. Startup checks the model with one
# request and prints a NOTE when the account cannot use it.
GROQ_MODEL=openai/gpt-oss-120b

# Extra completion tokens for a reasoning model, whose hidden reasoning counts
# against the answer cap (0 = no allowance; needed for openai/gpt-oss-120b).
LLM_REASONING_TOKENS=2048

# Network address the web app listens on. 127.0.0.1 (the default) is this
# computer only; set 0.0.0.0 to reach it from other devices on the network.
# APP_HOST=127.0.0.1

# Optional: OCR embedded images in the PDF.
# Off by default because first-run indexing takes several extra minutes.
# Uses rapidocr-onnxruntime (pure pip, no system Tesseract).
# ENABLE_OCR=1

# Arabic support (PF-11). All on by default; see README "Arabic support".
# ARABIC_SUPPORT=1
# ARABIC_QUERY_MODEL_FALLBACK=1
# ARABIC_QUERY_MIN_COVERAGE=0.6
# ARABIC_ANSWER_TRANSLATION=1
# Hard cap on model requests per process (bounded evaluations); 0 = no cap.
# LLM_PROCESS_CALL_CAP=0

# Saved conversations (PF-13). The SQLite file and the cookie-signing secret
# live under var/ (ignored by git); override the locations if needed.
# APP_DB_PATH=var/app.db
# APP_STORAGE_SECRET_PATH=var/storage_secret.txt
# APP_STORAGE_SECRET=            # set to use a fixed secret instead of the file
