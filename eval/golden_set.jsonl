{"id": "evaluation-001", "category": "evaluation", "question": "What are the performance rating categories for faculty evaluation?", "expected_route": "list", "expected_pages": [128], "expected_answer": "Excellent (90-100), Very Good (80-89), Meets Expectation (70-79), and Needs Attention (0-69).", "grading": "must_include", "must_include": ["excellent", "very good", ["meets expectation", "meets expectations"], "needs attention"], "must_not_include": [], "source": "part1", "part1_verdict": "", "evidence_quote": "Excellent 90-100; Very Good 80-89; Meets Expectation 70-79; Needs Attention 0-69", "notes": "Four-part list rendered as a table on page 128. Tests row/row_window chunking as well as the two-sentence prompt cap."}
