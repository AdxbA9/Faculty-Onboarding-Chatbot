{"id": "university-002", "category": "vision_mission", "question": "What is the University of Sharjah's mission?", "expected_route": "policy", "expected_pages": [15], "expected_answer": "We are an innovative world-class teaching, learning and research institution providing a distinctive, inspirational, creative, and supportive environment.", "grading": "must_include", "must_include": ["world-class", "distinctive", "supportive"], "must_not_include": [], "source": "part1", "part1_verdict": "", "evidence_quote": "We are an innovative world-class teaching, learning and research institution providing a distinctive, inspirational, creative, and supportive environment.", "notes": ""}
{"id": "programs-001", "category": "count", "question": "How many degree programs does UoS offer in Fall 2025/2026?", "expected_route": "count", "expected_pages": [15], "expected_answer": "149 academic degree programs.", "grading": "must_include", "must_include": ["149"], "must_not_include": [], "source": "part1", "part1_verdict": "", "evidence_quote": "As of the Fall semester of the academic year 2025/2026, we offer a total of 149 academic degree programs", "notes": "Contains 'Fall', which also matches YEAR_TERM_PATTERN. count is tested before date in classify_query, so this should still route to count."}
{"id": "programs-002", "category": "count", "question": "How many Bachelor, Master, PhD, and Post Graduate programs does UoS offer in Fall 2025/2026?", "expected_route": "count", "expected_pages": [15], "expected_answer": "62 Bachelor's degrees, 60 Master's degrees, 23 PhD degrees, and 4 Post Graduate and Professional Diploma degrees.", "grading": "must_include", "must_include": ["62", "60", "23", "4"], "must_not_include": [], "source": "part1", "part1_verdict": "", "evidence_quote": "including 62 Bachelor's degrees, 60 Master's degrees, 23 PhD degrees, and 4 Post Graduate and Professional Diploma degrees", "notes": "Four-part count question. The primary test case for bug 2 (two-sentence prompt cap) and for partial-credit scoring."}
{"id": "university-003", "category": "international", "question": "What does the handbook say about UoS's international outlook?", "expected_route": "policy", "expected_pages": [15], "expected_answer": "While deeply rooted in Islamic and Arabic traditions, UoS promotes an international outlook and fosters respect for individuals and cultures worldwide. It is described as a major international centre for learning where East meets West and North meets South, with programs connected through agreements with universities in Germany, Spain, Australia, Canada, Japan, the United Kingdom, and the United States.", "grading": "judge_only", "must_include": [], "must_not_include": [], "source": "part1", "part1_verdict": "", "evidence_quote": "the University of Sharjah promotes an international outlook and fosters respect for individuals and cultures from around the world... connected through agreements with universities in Germany, Spain, Australia, Canada, Japan, the United Kingdom, and the United States", "notes": "Open-ended. No fair deterministic rule exists, so it is left for eval/judge.py rather than scored with a guess."}
{"id": "committee-001", "category": "governance", "question": "What is the function of standing committees at UoS?", "expected_route": "policy", "expected_pages": [28], "expected_answer": "They play a governance role, enabling faculty and other members of the university community to contribute actively to policy development and decision-making.", "grading": "must_include", "must_include": [["policy development", "policy"], ["decision-making", "decision making"]], "must_not_include": [], "source": "part1", "part1_verdict": "", "evidence_quote": "Standing committees play a crucial governance role at the University of Sharjah, enabling faculty and other members of the institution's community to actively contribute to policy development and decision-making.", "notes": "Note: 'standing committees' (plural) does NOT match the list regex in classify_query, because the pattern ends in \\b after the singular 'standing committee'. Expected route is therefore policy."}
{"id": "committee-002", "category": "governance", "question": "Name one standing committee at UoS", "expected_route": "list", "expected_pages": [28, 29], "expected_answer": "Any one of the listed standing committees, for example University Policy, Study Plans and Curricula, Graduation, or the Faculty Grievance Committee.", "grading": "any_of", "must_include": ["University Policy", "Faculty Contract Renewal and Hiring", "Study Plans and Curricula", "Student Affairs", "Student Support Fund", "Graduation", "Student Success", "Laboratory Safety", "University Central Laboratories", "Institutional Effectiveness and Accreditation", "Central Committee for Faculty Promotion", "Faculty Housing Committee", "Faculty Grievance Committee", "Standing Investigation Committee", "Employee Disciplinary Committee", "Committee for International Relations and Rankings", "University Learning Environment", "University Project Advisory", "Women in Research", "Tender Review", "Graduate Studies Council", "University Research Board"], "must_not_include": [], "source": "part1", "part1_verdict": "", "evidence_quote": "The University have the following standing committees: University Policy; Faculty Contract Renewal and Hiring; Study Plans and Curricula; ...", "notes": "Graded any_of: naming one valid committee is the whole task. Requiring all of them would mis-score a correct answer."}
