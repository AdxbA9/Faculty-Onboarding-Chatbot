# UOS Faculty Onboarding Chatbot - golden evaluation set
#
# One JSON object per line. Blank lines and lines starting with '#' are ignored.
#
# Every expected_answer, expected_pages value and evidence_quote in this file was
# read directly out of data/UOS Faculty Handbook 25-26.pdf. Nothing is inferred
# and nothing is invented. expected_pages are PHYSICAL PDF page numbers (1-based),
# which for this document happen to equal the printed "Page N" footer.
#
# Fields:
#   id              stable identifier, used to join runs to cases
#   category        question family (see eval/README.md)
#   question        asked verbatim
#   expected_route  intent classify_query SHOULD return (measures bug 4)
#   expected_pages  page(s) that support the answer (measures bug 3)
#   expected_answer human-readable reference answer, for the report and the judge
#   grading         must_include | any_of | exact | refusal | judge_only
#   must_include    terms that must appear. A nested list means "any of these"
#   must_not_include terms whose presence makes the answer wrong
#   source          part1 (from the Part 1 manual test set) | new
#   part1_verdict   Part 1 outcome, if known: correct | partial | incorrect | ""
#   evidence_quote  the handbook text the expected answer came from
{"id": "handbook-001", "category": "handbook_purpose", "question": "What is the main purpose of the University of Sharjah Faculty Handbook?", "expected_route": "policy", "expected_pages": [2], "expected_answer": "It is a comprehensive guide that outlines the policies, procedures, and essential information relevant to faculty members at the University of Sharjah.", "grading": "must_include", "must_include": ["policies", "procedures"], "must_not_include": [], "source": "part1", "part1_verdict": "correct", "evidence_quote": "a comprehensive guide that outlines policies, procedures, and essential information relevant to faculty members at our esteemed institution", "notes": "", "part1_ref": "Report Table 6-2, pilot Q3 (score 5/5)"}
{"id": "handbook-002", "category": "handbook_audience", "question": "Who is the Faculty Handbook intended for?", "expected_route": "policy", "expected_pages": [2, 3], "expected_answer": "It is meant for the internal use of University of Sharjah faculty and academic staff, both new hires and seasoned faculty members.", "grading": "must_include", "must_include": ["faculty", "academic staff"], "must_not_include": [], "source": "part1", "part1_verdict": "incorrect", "evidence_quote": "This handbook is meant for the internal use of University of Sharjah faculty and academic staff", "notes": "Page 2 frames it as new and seasoned faculty; page 3 gives the formal audience statement.", "part1_ref": "Report Table 6-2, pilot Q2 (score 1/5) - chatbot refused an answerable question"}
{"id": "handbook-003", "category": "handbook_scope", "question": "What should faculty consult if the handbook does not cover a topic fully?", "expected_route": "policy", "expected_pages": [2], "expected_answer": "Their respective department and college handbooks, academic policies and procedures, the staff handbook, and other University documents.", "grading": "must_include", "must_include": ["department", "college", "staff handbook"], "must_not_include": [], "source": "part1", "part1_verdict": "correct", "evidence_quote": "we encourage faculty members to also consult their respective department and college handbooks, academic policies and procedures, the staff handbook, and other University documents", "notes": "", "part1_ref": "Report Table 6-2, pilot Q1 (score 5/5)"}
{"id": "handbook-004", "category": "handbook_values", "question": "What are the three core areas of excellence emphasized by the university?", "expected_route": "list", "expected_pages": [2], "expected_answer": "Teaching, research, and service.", "grading": "must_include", "must_include": ["teaching", "research", "service"], "must_not_include": [], "source": "part1", "part1_verdict": "", "evidence_quote": "our commitment to excellence in teaching, research, and service serves as the foundation of our academic community", "notes": "Also restated on page 15."}
{"id": "handbook-005", "category": "handbook_values", "question": "What institutional principles are highlighted in the handbook preface?", "expected_route": "policy", "expected_pages": [2], "expected_answer": "Academic freedom, diversity, shared governance, and social responsibility.", "grading": "must_include", "must_include": ["academic freedom", "diversity", "shared governance", "social responsibility"], "must_not_include": [], "source": "part1", "part1_verdict": "", "evidence_quote": "Our institution values the principles of academic freedom, diversity, shared governance, and social responsibility.", "notes": "Four-part answer. A direct test of bug 2 (prompt caps answers at two sentences)."}
{"id": "handbook-006", "category": "faculty_responsibility", "question": "What is the faculty member's responsibility regarding the handbook?", "expected_route": "policy", "expected_pages": [2], "expected_answer": "To familiarize themselves with the contents of the handbook and to adhere to the policies and procedures outlined within it.", "grading": "must_include", "must_include": [["familiarize", "familiarise"], ["adhere", "comply", "follow"]], "must_not_include": [], "source": "part1", "part1_verdict": "", "evidence_quote": "it is the responsibility of all faculty members to familiarize themselves with the contents of this handbook and to adhere to the policies and procedures outlined within", "notes": ""}
{"id": "handbook-007", "category": "handbook_updates", "question": "How are faculty advised to stay informed about handbook updates?", "expected_route": "policy", "expected_pages": [2], "expected_answer": "By regularly referring to the most current version of the handbook; the University communicates significant changes when applicable.", "grading": "must_include", "must_include": [["regularly", "regular"], ["current version", "most current", "latest version"]], "must_not_include": [], "source": "part1", "part1_verdict": "", "evidence_quote": "we urge faculty to regularly refer to the most current version to stay informed", "notes": ""}
{"id": "handbook-008", "category": "policy_yesno", "question": "Does the handbook create contractual obligations?", "expected_route": "policy_yesno", "expected_pages": [3], "expected_answer": "No. It provides general information only and should not be seen as creating any contractual obligations.", "grading": "must_include", "must_include": [["not", "no"], "contractual"], "must_not_include": [], "source": "part1", "part1_verdict": "", "evidence_quote": "intended to provide general information only and should not be seen as creating any contractual obligations", "notes": "Short negation terms are matched on word boundaries so 'not' does not match inside 'note'."}
{"id": "handbook-009", "category": "policy_yesno", "question": "Can UoS change handbook policies without prior notice?", "expected_route": "policy_yesno", "expected_pages": [3], "expected_answer": "Yes. The University retains the right to modify or discontinue any policies or conditions described in the handbook without prior notice.", "grading": "must_include", "must_include": [["without prior notice", "retains the right"]], "must_not_include": ["cannot", "may not"], "source": "part1", "part1_verdict": "", "evidence_quote": "The University of Sharjah retains the right to modify or discontinue any policies or conditions described herein without prior notice.", "notes": ""}
